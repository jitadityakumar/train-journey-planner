REMOTE_USER=your-username
REMOTE_HOST=jk-server-ccu
# Must be exactly $HOME/otp-sidecar for that user on REMOTE_HOST —
# otp-poll.service's WorkingDirectory hardcodes %h/otp-sidecar (systemd's
# %h = the unit owner's home dir), so anything else deploys a timer that
# fails on every fire. deploy-otp-sidecar.sh checks this and refuses to
# proceed otherwise.
REMOTE_APP_DIR=/home/your-username/otp-sidecar
