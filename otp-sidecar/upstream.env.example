# Copied to upstream.env (gitignored) on jk-server-ccu by deploy.sh's first run —
# fill in and keep in sync manually after that (deploy.sh never overwrites an
# existing upstream.env). Tells poll_and_build.sh where to pull gtfs.zip from.
UPSTREAM_USER=your-username
UPSTREAM_HOST=jkumar-server
# Must match DATA_DIR the main app writes gtfs.zip/gtfs.zip.sha256 into (see app/config.py)
UPSTREAM_DATA_DIR=/path/to/train-journey-planner/data
